# Public application origin, without a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project values safe for use in the browser. Realtime Broadcast must be enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only ICE configuration. Comma-separated STUN URLs are supported.
STUN_URL=stun:stun.cloudflare.com:3478,stun:stun.cloudflare.com:53,stun:stun.l.google.com:19302

# Recommended: Cloudflare Realtime TURN generates one-hour browser credentials.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Alternative static TURN configuration.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Reserved for a distributed production rate limiter (Upstash or compatible).
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
